{
  "name": "pantaneira-financeiro",
  "version": "1.9.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create pantaneira-financeiro-db",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:query:local": "wrangler d1 execute DB --local --command",
    "db:query:remote": "wrangler d1 execute DB --remote --command"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
